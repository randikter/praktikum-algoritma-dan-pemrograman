# #program membedakan bentuk segitiga dari berdasarkan panjang sisi dari 1 sampai 10

a = int(input("Masukkan panjang sisi pertama: "))
b = int(input("Masukkan panjang sisi kedua: "))
c = int(input("Masukkan panjang sisi ketiga: "))

if a == b == c:
    print("Segitiga sama sisi")
elif a == b or b == c or a == c:
    print("Segitiga sama kaki")
elif a + b <= c or a + c <= b or b + c <= a:
    print("Bukan segitiga")
else:
    print("Segitiga sembarang")

#konversi nilai 1 sampai 100 ke huruf A, B, C, D, E

nilai = int(input("Masukkan nilai angka: "))

if nilai >= 100 or nilai < 0:
    print("Nilai tidak valid, masukkan angka antara 0 sampai 100")
elif nilai == 100:
    print("Nilai huruf: S")
elif nilai >= 90:
    print("Nilai huruf: A")
elif nilai >= 80:
    print("Nilai huruf: B")
elif nilai >= 70:
    print("Nilai huruf: C")
elif nilai >= 60:
    print("Nilai huruf: D")
else:
    print("Nilai huruf: E")

