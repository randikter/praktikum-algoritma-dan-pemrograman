import math

# operasi aritmatika

a = int(input(" masukkan nilai a: "))
b = int(input(" masukkan nilai b: "))
print("jumlah a ditambah b adalah", a + b)
print("selisih antara a dan b adalah", a - b)
print("jumlah a dikali b adalah", a * b)
print("jumlah sisa pembagian dari hasi a dibagi b adalah", a % b)
print("jumlah a dibagi b adalah", a / b)
print("hasil dari log(a) adalah", math.log(a))
print("hasil a pangkat b adalah", a**b)

# operasi trigonometri
alas = int(input("masukkan panjang sisi alas (a): "))
tinggi = int(input("masukkan panjang sisi tinggi (b): "))
miring = math.sqrt(alas**2 + tinggi**2)
print("panjang sisi miring (c) adalah", miring)

# operasi hitung volume dan luas permukaan tabung
jarijari = int(input("masukkan jari-jari tabung (r): "))
tinggitabung = int(input("masukkan tinggi tabung (t): "))
print("Volume tabung adalah: ", math.pi * jarijari**2 * tinggitabung)
print("Luas permukaan tabung adalah: ", 2 * math.pi * jarijari * (jarijari + tinggitabung))
