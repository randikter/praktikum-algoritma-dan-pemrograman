#program fungsi untuk merata-ratakan nilai sesuai dengan kategori huruf

total = 0.0
count = 0
nhuruf = input("Masukan nilai: ")
while nhuruf in ['A', 'A-', 'B+', 'B', 'B-', 'C+', 'C', 'C-', 'D', 'E']:
    if nhuruf == 'A':
        nilai = 4
    elif nhuruf == 'A-':
        nilai = 3.75
    elif nhuruf == 'B+':
        nilai = 3.50
    elif nhuruf == 'B':
        nilai = 3
    elif nhuruf == 'B-':
        nilai = 2.75
    elif nhuruf == 'C+':
        nilai = 2.50
    elif nhuruf == 'C':
        nilai = 2
    elif nhuruf == 'C-':
        nilai = 1.75
    elif nhuruf == 'D':
        nilai = 1.50
    elif nhuruf == 'E':
        nilai = 1.25
    print("nilai: ", nilai)
    total += nilai
    count += 1
    nhuruf = input("Masukan nilai: ")
print("rata - rata nya adalah: ", total/count)

#program menghitung tiket masuk kebun binatang berdasarkan umur beserta pembayaran

total = 0.0
umur = input("Masukan umur: ")
while umur != "":
    if int(umur) <= 2:
        harga = 0.00
        print("Gratis")
    elif int(umur) >= 3 and int(umur) <= 12:
        harga = 14.00
        print("Harga $", harga)
    elif int(umur) >= 65:
        harga = 18.00
        print("Harga $", harga)
    else:
        harga = 23.00
        print("Harga $", harga)
    print("Running total: $", total + harga)
    total += harga
    umur = input("Masukan umur: ")
uang = float(input("Masukkan jumlah uang: "))
print("running kembalian:", uang - total)

#program rekap nilai kelas mahasiswa

m = int(input("Masukan jumlah mahasiswa: "))
i=1
total=0.0
daftar_nama = []
daftar_nilai = []
jumlah_lulus = 0
while i <= m:
    print("\nMahasiswa ke-", i)
    nama = input("Nama: ")
    nilai = float(input("Nilai " + nama + " (0-100): "))
    daftar_nama.append(nama)
    daftar_nilai.append(nilai)
    if nilai >= 60:
        a = ("LULUS")
        jumlah_lulus += 1
    else:
        a = ("TIDAK LULUS")
    print(f"{nama}: nilai {nilai} | {a}")
    total += nilai
    i += 1
    idx_max = daftar_nilai.index(max(daftar_nilai))
    idx_min = daftar_nilai.index(min(daftar_nilai))
print("\n===== REKAP NILAI KELAS =====")
print("Jumlah mahasiswa : ", m)
print(f"Rata-rata kelas  : {total/m:.2f}")
print(f"Nilai tertinggi  : {max(daftar_nilai)} ({daftar_nama[idx_max]})")
print(f"Nilai terendah   : {min(daftar_nilai)} ({daftar_nama[idx_min]})")
print(f"Jumlah lulus     : {jumlah_lulus} dari {m}")
